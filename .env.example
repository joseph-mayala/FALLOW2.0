# Fallow environment
# Copy to .env.local. The key is OPTIONAL: the app runs without it, and the
# pages make no third-party request.

# Google Gemini: turns on the optional AI analysis in the rotation sheet.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override. Defaults to gemini-3.5-flash-lite
# (gemini-2.0-flash was shut down on 1 June 2026).
GEMINI_MODEL=
